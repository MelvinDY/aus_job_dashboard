# Copy to .env. Every value below already has a working default in
# docker-compose.yml and dbt/profiles.yml, so the project runs with no .env at
# all — this file exists to document the knobs, not to gate the pipeline.

# ── Local warehouse (the default target) ─────────────────────────────────────
# SQL Server Developer edition in Docker. Free, no cloud account, no keys.
# This password is a local-only development credential and is meant to be public.
MSSQL_SA_PASSWORD=LocalDev_Passw0rd!
MSSQL_DATABASE=aus_job_dashboard
MSSQL_HOST=localhost
MSSQL_PORT=1433

# Container memory ceiling, in MB. Lower it if the container is heavy on your
# laptop; SQL Server will otherwise grow to consume most of the host's RAM.
MSSQL_MEMORY_LIMIT_MB=2048

# Connection string used by scripts/load_raw.py.
# Defaults to the local container above when unset.
SQL_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=aus_job_dashboard;Uid=sa;Pwd=LocalDev_Passw0rd!;Encrypt=yes;TrustServerCertificate=yes

# ── Alternative target: Azure SQL (documented, not required) ─────────────────
# v1 of this project ran on Azure SQL. That instance was decommissioned on
# purpose — a portfolio project should not carry a monthly bill — so the local
# container above is the supported path. The T-SQL dialect is the same, so
# pointing at Azure SQL (or Fabric) is a connection-string and dbt-profile
# change, not a model change. To use it, set SQL_CONN_STR to the value below and
# switch the dbt target with: dbt build --target azure
#
# SQL_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=<your-server>.database.windows.net;Database=<your-db>;Uid=<username>;Pwd=<password>;Encrypt=yes
# AZURE_SQL_SERVER=<your-server>.database.windows.net
# AZURE_SQL_DATABASE=<your-db>
# AZURE_SQL_USER=<username>
# AZURE_SQL_PASSWORD=<password>
